.moon-wrap {
  display: flex; justify-content: center;
  margin-top: 18px;
}
.moon-cv {
  width: 112px;
  height: 112px;
  display: block;
}
.moon-tip {
  text-align: center; font-size: 9px; font-weight: 800;
  color: var(--wheat); opacity: .72; margin-top: 4px;
}

.figure { display: flex; justify-content: center; margin-top: 14px; }
.figure__main { font-size: 38px; font-weight: 800; color: var(--night); line-height: 1.1; }
.figure__sub {
  text-align: center; font-size: 10px; font-weight: 800;
  color: var(--wheat); margin-top: 4px;
}

.times { display: flex; gap: 8px; margin-top: 16px; }
.times picker { flex: 1; }
.time-card {
  border: 3px solid var(--wood);
  border-radius: var(--r-card);
  background: var(--cream);
  box-shadow: inset 0 0 0 2px var(--ring), 0 4px 0 rgba(0, 0, 0, .26);
  padding: 10px 12px;
  text-align: center;
}
.time-card__label { font-size: 10px; font-weight: 800; color: var(--ink-2); }
.time-card__val { font-size: 22px; font-weight: 800; color: var(--ink); line-height: 1.3; }

.tip {
  margin-top: 8px; padding: 5px 10px;
  background: #FFF1D0; border: 2px solid var(--wood); border-radius: 8px;
  font-size: 10px; font-weight: 800; text-align: center;
}

.q {
  flex: 1; height: 52px;
  display: flex; align-items: center; justify-content: center;
  border: 3px solid var(--wood);
  border-radius: var(--r-btn);
  background: var(--wheat);
  font-size: 18px; font-weight: 800; color: var(--ink-2);
  box-shadow: 0 3px 0 rgba(0, 0, 0, .22);
  transition: transform 60ms linear;
}
.q:active { transform: translateY(2px); }
.q--on { background: var(--night); color: var(--cream); border-color: var(--wood-d); }

.notice {
  text-align: center; font-size: 10px; font-weight: 800;
  color: var(--wheat); opacity: .8; margin-top: 12px;
}

.pop {
  position: fixed; left: 0; right: 0; top: 42%;
  text-align: center;
  font-size: 40px; font-weight: 800; color: var(--gold);
  text-shadow: 0 3px 0 var(--wood-d);
  animation: popUp 900ms linear forwards;
  pointer-events: none; z-index: 99;
}
@keyframes popUp {
  0%   { opacity: 0; transform: translateY(10px) scale(.8); }
  25%  { opacity: 1; transform: translateY(0) scale(1.1); }
  60%  { opacity: 1; transform: translateY(-16px) scale(1); }
  100% { opacity: 0; transform: translateY(-40px) scale(1); }
}
