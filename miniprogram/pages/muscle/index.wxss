.weekNum { font-size: 12px; font-weight: 800; color: var(--grass); }
.inten { width: 8px; height: 26px; border-radius: 3px; background: var(--ring); flex: none; }
.inten--easy { background: var(--water); }
.inten--mid { background: var(--grass); }
.inten--hard { background: var(--fire); }
.del { font-size: 10px; font-weight: 800; color: var(--fire); padding: 4px 8px; }

.opt {
  flex: 1; height: 40px; display: flex; align-items: center; justify-content: center;
  border: 3px solid var(--wood); border-radius: var(--r-btn);
  background: var(--wheat); font-size: 13px; font-weight: 800; color: var(--ink-2);
}
.opt--on { background: var(--ink); color: var(--cream); }

.notice {
  text-align: center; font-size: 10px; font-weight: 800;
  color: var(--wheat); opacity: .8; margin-top: 12px;
}

.pop {
  position: fixed; left: 0; right: 0; top: 42%;
  text-align: center;
  font-size: 40px; font-weight: 800; color: var(--gold);
  text-shadow: 0 3px 0 var(--wood-d);
  animation: popUp 900ms linear forwards;
  pointer-events: none; z-index: 99;
}
@keyframes popUp {
  0%   { opacity: 0; transform: translateY(10px) scale(.8); }
  25%  { opacity: 1; transform: translateY(0) scale(1.1); }
  60%  { opacity: 1; transform: translateY(-16px) scale(1); }
  100% { opacity: 0; transform: translateY(-40px) scale(1); }
}
