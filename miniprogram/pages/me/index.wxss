.who { display: flex; align-items: center; padding: 12px; }
.who__av {
  width: 52px; height: 52px; border-radius: 10px;
  border: 3px solid var(--wood); background: var(--wheat);
  overflow: hidden; flex: none;
}
.who__img { width: 48px; height: 48px; }
.who__pen { width: 15px; height: 15px; opacity: .65; }

.list { padding: 0 12px; }
.warn {
  margin-top: 12px;
  font-size: 10px; line-height: 1.7;
  color: var(--wheat); opacity: .8;
  padding: 0 4px;
}

.avatars { display: flex; flex-wrap: wrap; gap: 8px; }
.av {
  width: 44px; height: 44px; border-radius: 9px;
  border: 3px solid var(--wood); background: var(--wheat);
  display: flex; align-items: center; justify-content: center;
}
.av--on { border-color: var(--gold); background: var(--gold); box-shadow: 0 0 0 2px var(--wood); }
.av__img { width: 40px; height: 40px; }
