.splash {
  min-height: 100vh;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  padding: 0 24px;
}

/* 木框尺寸固定 128×160，不随小人变化 */
.frame {
  width: 128px; height: 160px;
  background: var(--cream);
  border: 4px solid var(--wood-d);
  border-radius: 18px;
  box-shadow: inset 0 0 0 3px var(--ring), 0 6px 0 rgba(0, 0, 0, .3);
  display: flex; align-items: center; justify-content: center;
}
.frame__inner { width: 50px; height: 70px; }

/* 3 帧硬切：雪碧图 150×70，每帧 50×70 */
.hero {
  width: 50px; height: 70px;
  background-image: url('/assets/splash/hero-3f.png');
  background-repeat: no-repeat;
  background-size: 150px 70px;
  animation: heroLift 1.05s steps(3) infinite;
}
@keyframes heroLift {
  from { background-position: 0 0; }
  to   { background-position: -150px 0; }
}

.slogan {
  margin-top: 26px; height: 26px;
  display: flex; align-items: center;
}
.slogan__text {
  font-size: 14px; font-weight: 800;
  color: var(--cream); letter-spacing: 2px;
}
.slogan__caret {
  font-size: 13px; color: var(--gold);
  margin-left: 3px;
  animation: blink 600ms steps(2) infinite;
}
@keyframes blink { 0% { opacity: 1 } 50% { opacity: 0 } 100% { opacity: 1 } }

.loader {
  margin-top: 22px;
  display: flex; gap: 4px;
}
.loader__cell {
  width: 16px; height: 8px; border-radius: 2px;
  background: rgba(255, 249, 232, .28);
  border: 2px solid var(--wood-d);
}
.loader__cell--on { background: var(--gold); }

.hint {
  position: absolute; bottom: calc(30px + env(safe-area-inset-bottom));
  font-size: 10px; color: var(--wheat); opacity: .55;
}
