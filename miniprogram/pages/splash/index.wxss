.splash {
  min-height: 100vh;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  padding: 0 24px;
}

/* 木框尺寸固定 128×160，不随小人变化 */
.frame {
  width: 128px; height: 160px;
  background: var(--cream);
  border: 4px solid var(--wood-d);
  border-radius: 18px;
  box-shadow: inset 0 0 0 3px var(--ring), 0 6px 0 rgba(0, 0, 0, .3);
  display: flex; align-items: center; justify-content: center;
}
/* 窗口只留一帧大小，多余两帧裁掉 */
.frame__inner {
  width: 50px; height: 70px;
  overflow: hidden;
}

/* 3 帧硬切：雪碧图 450×210（单帧 150×210），按 150×70 布局，
   1.05s 循环，靠 margin 位移换帧。
   注意：不能用 background-image 引本地图，小程序 WXSS 不支持本地资源。 */
.hero {
  width: 50px; height: 70px;
  overflow: hidden;
}
.hero__strip {
  display: block;
  width: 150px; height: 70px;
  animation: heroLift 1.05s steps(1, end) infinite;
}
@keyframes heroLift {
  0%,      33.32%  { margin-left: 0; }
  33.33%,  66.65%  { margin-left: -50px; }
  66.66%,  100%    { margin-left: -100px; }
}

.slogan {
  margin-top: 26px; height: 26px;
  display: flex; align-items: center;
}
.slogan__text {
  font-size: 14px; font-weight: 800;
  color: var(--cream); letter-spacing: 2px;
}
.slogan__caret {
  font-size: 13px; color: var(--gold);
  margin-left: 3px;
  animation: blink 600ms steps(2) infinite;
}
@keyframes blink { 0% { opacity: 1 } 50% { opacity: 0 } 100% { opacity: 1 } }

.loader {
  margin-top: 22px;
  display: flex; gap: 4px;
}
.loader__cell {
  width: 16px; height: 8px; border-radius: 2px;
  background: rgba(255, 249, 232, .28);
  border: 2px solid var(--wood-d);
}
.loader__cell--on { background: var(--gold); }

.hint {
  position: absolute; bottom: calc(30px + env(safe-area-inset-bottom));
  font-size: 10px; color: var(--wheat); opacity: .55;
}
