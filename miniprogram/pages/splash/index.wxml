<view class="splash" bindtap="onSkip">
  <view class="frame">
    <view class="frame__inner">
      <view class="hero">
        <image class="hero__strip" src="/assets/splash/hero-3f.png" mode="scaleToFill" />
      </view>
    </view>
  </view>

  <view class="slogan">
    <text class="slogan__text">{{typed}}</text>
    <text class="slogan__caret">▊</text>
  </view>

  <view class="loader">
    <view wx:for="{{cells}}" wx:key="index" class="loader__cell {{item ? 'loader__cell--on' : ''}}"></view>
  </view>

  <view class="hint">点击跳过</view>
</view>
