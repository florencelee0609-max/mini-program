.sheet-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(40, 26, 14, .55);
  z-index: 90;
}
.sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 91;
  background: #FFF9E8;
  border-top: 3px solid #5E3C22;
  border-radius: 16px 16px 0 0;
  padding: 0 14px;
  transform: translateY(110%);
  transition: transform 160ms linear;
  box-shadow: inset 0 3px 0 #E8C68C;
}
.sheet--on { transform: translateY(0); }
.sheet__bar {
  width: 44px; height: 4px; border-radius: 2px;
  background: #E8C68C; margin: 8px auto 0;
}
.sheet__head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 10px 0 8px;
}
.sheet__title { font-size: 15px; font-weight: 800; color: #3E2410; }
.sheet__close {
  width: 30px; height: 30px; border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
  border: 2px solid #5E3C22; background: #F7E3BC;
}
.sheet__close-ico { width: 14px; height: 14px; }
.sheet__body { padding-bottom: 8px; max-height: 66vh; overflow-y: auto; }
.sheet__safe { height: calc(10px + env(safe-area-inset-bottom)); }
