<view class="nav" style="padding-top:{{statusBar}}px">
  <view class="nav__bar">
    <view class="nav__side">
      <view wx:if="{{back}}" class="nav__back" bindtap="onBack">
        <image class="nav__back-ico" src="/assets/icons/back-w.png" mode="aspectFit" />
      </view>
    </view>
    <view class="nav__mid">
      <view class="nav__title">{{title}}</view>
      <view wx:if="{{sub}}" class="nav__sub">{{sub}}</view>
    </view>
    <view class="nav__side nav__side--right">
      <slot name="right"></slot>
    </view>
  </view>
</view>
<view style="height:{{statusBar + 46}}px"></view>
